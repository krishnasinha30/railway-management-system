PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/railway-management-system
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
VERCEL_FRONTEND_URL=https://YOUR-VERCEL-FRONTEND.vercel.app

# ==============================================================================
# EMAIL NOTIFICATION SYSTEM CONFIGURATION
# ==============================================================================
# Gmail API (HTTPS/443; preferred when configured):
# Create OAuth credentials with the Gmail API send scope. Keep every value private.
GMAIL_API_USER=your-email@gmail.com
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=

# Optional alternative provider: Resend HTTPS API
RESEND_API_KEY=

# Optional fallback: Gmail or another SMTP service
# Example for Gmail (use 16-character App Password, NOT your regular password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Sender Identity:
# Gmail API: use the same address as GMAIL_API_USER
SMTP_FROM=Rail Center <your-email@gmail.com>