PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/railway-management-system
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
VERCEL_FRONTEND_URL=https://YOUR-VERCEL-FRONTEND.vercel.app

# ==============================================================================
# EMAIL NOTIFICATION SYSTEM CONFIGURATION
# ==============================================================================
# Primary Engine (Cloud Production - Render/AWS/Vercel/DigitalOcean):
# Uses Resend API via HTTPS (Port 443). Bypasses cloud outbound SMTP port restrictions.
# Get free API key at https://resend.com (1-click Google login, no CC required)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Secondary Fallback Engine (Local Development SMTP):
# Uses Nodemailer with IPv4 (family: 4) when RESEND_API_KEY is omitted or fails.
# Example for Gmail (use 16-character App Password, NOT your regular password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Sender Identity:
# Free Resend testing: "Rail Center <onboarding@resend.dev>"
# Custom verified domain: "Rail Center <noreply@yourdomain.com>"
SMTP_FROM=Rail Center <onboarding@resend.dev>